{
  "name": "steem-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm docs:gen && vitepress dev docs",
    "build": "pnpm docs:gen && vitepress build docs",
    "preview": "vitepress preview docs",
    "docs:gen": "node scripts/gen-api-docs.mjs && node scripts/gen-api-docs.mjs --locale zh && node scripts/gen-api-docs.mjs --locale ru && node scripts/gen-api-docs.mjs --locale fr && node scripts/gen-api-docs.mjs --locale de && node scripts/gen-api-docs.mjs --locale it && node scripts/gen-api-docs.mjs --locale es",
    "validate:data": "node scripts/validate-data.mjs",
    "scrape:api-defs": "node scripts/scrape-api-defs.mjs",
    "test:curl": "node scripts/test-curl.mjs",
    "audit:drift": "node scripts/audit-drift.mjs",
    "audit:coverage": "node scripts/coverage-sweep.mjs",
    "audit:source-crosscheck": "node scripts/audit-source-crosscheck.mjs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.44",
    "yaml": "^2.9.1"
  }
}
